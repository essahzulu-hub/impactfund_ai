# Copy to .env and fill in real values.
# Skip values you don't need (e.g. PayPal keys for local-only dev).

# Database (required)
DATABASE_URL=postgresql://impactfund_user:essah@localhost:5432/impactfund

# Flask
FLASK_SECRET_KEY=change-me

# AI (Groq, OpenAI-compatible)
GROQ_API_KEY=your_actual_groq_api_key

# PayPal sandbox (optional unless you want real payments)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
